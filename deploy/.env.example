# Copy to deploy/.env (git-ignored) on the VPS.
# Public name of the VPS. Without your own domain, <ip-with-dashes>.sslip.io works,
# e.g. 203-0-113-7.sslip.io. Ports 80 and 443 must be open for the certificate.
DOMAIN=
# Required for uploads and deletes. Reuse the one in your local .env so
# `mise run push` works against both, or generate one: openssl rand -hex 32
API_TOKEN=
# Comma-separated origins allowed to read the API from a browser ("*" = any).
CORS_ORIGINS=*
# The cache holds up to CACHE_MAX_ENTRIES responses of up to CACHE_MAX_ITEM_MB each,
# plus a gzip copy. Lower these on a 1 GB VPS.
CACHE_MAX_ENTRIES=128
CACHE_TTL=10m
CACHE_MAX_ITEM_MB=32
CACHE_HTTP_MAX_AGE=60s
MAX_UPLOAD_MB=256
KEEP_VERSIONS=2
HOTSPOT_LIMIT_DEFAULT=50000
HOTSPOT_LIMIT_MAX=200000
