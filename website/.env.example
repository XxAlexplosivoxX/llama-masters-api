# Base URL of llama-masters-api. Leave empty to use the static files in public/data/regions
# (copied with `npm run data:sync`).
VITE_DATA_URL=http://localhost:8080

# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ for `npm run data:brazil`.
# Put the real value in .env.local (git-ignored). Never prefix it with VITE_: it must not reach the browser.
FIRMS_MAP_KEY=
