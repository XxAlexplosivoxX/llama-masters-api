# Copy to .env (git-ignored); mise loads it for `mise run dev` and `mise run push`.
ADDR=:8080
DB_PATH=data/llama.db
# Required for uploads and deletes; generate one with: openssl rand -hex 32
API_TOKEN=
# Comma-separated origins allowed to read the API from a browser ("*" = any).
CORS_ORIGINS=*
CACHE_MAX_ENTRIES=256
CACHE_TTL=10m
CACHE_MAX_ITEM_MB=64
CACHE_HTTP_MAX_AGE=60s
MAX_UPLOAD_MB=256
KEEP_VERSIONS=2
HOTSPOT_LIMIT_DEFAULT=50000
HOTSPOT_LIMIT_MAX=200000
# Used by `llama-api push`.
API_URL=http://localhost:8080
